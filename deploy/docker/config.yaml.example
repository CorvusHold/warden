# Warden Configuration Example
#
# This file provides default configuration for the Warden agent.
# Copy and customize for your environment.
#
# Environment variables can be referenced using ${VAR_NAME} syntax.
# Secrets should be provided via environment variables, not hardcoded here.

# Agent configuration
agent:
  # Enable/disable the agent (can be toggled via CLI)
  enabled: true
  
  # Log level: trace, debug, info, warn, error
  log_level: ${WARDEN_LOG_LEVEL:-info}

# Default storage configuration for backups
# Individual commands can override these settings
storage_defaults:
  # Storage provider: s3 or minio
  provider: ${STORAGE_PROVIDER:-s3}
  
  # S3 bucket name
  bucket: ${STORAGE_BUCKET:-warden-backups}
  
  # Key prefix for organizing backups
  prefix: ${STORAGE_PREFIX:-postgres/}
  
  # AWS region (ignored for MinIO)
  region: ${AWS_REGION:-us-east-1}
  
  # Custom endpoint URL (required for MinIO)
  # For AWS S3, leave empty or set to https://s3.amazonaws.com
  endpoint: ${AWS_ENDPOINT:-}
  
  # Credentials - always use environment variables for secrets
  # access_key and secret_key are read from AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY

# Default PostgreSQL connection settings
# Individual commands can override these settings
postgres_defaults:
  # Default PostgreSQL user for backups
  user: ${POSTGRES_USER:-warden_backup}
  
  # Default port
  port: ${POSTGRES_PORT:-5432}
  
  # SSL mode: disable, allow, prefer, require, verify-ca, verify-full
  ssl_mode: ${POSTGRES_SSL_MODE:-prefer}
  
  # Default database for connection
  database: ${POSTGRES_DB:-postgres}

# Backup schedules (optional)
# Uncomment and configure for automated backups
