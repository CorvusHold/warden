# C2/AMQP configuration (optional - for managed deployments)
# Uncomment if connecting to a control plane
# c2:
#   amqp_url: ${AMQP_URL:-}
#   exchange: warden
#   reconnect_delay_seconds: 5
#   heartbeat_interval_seconds: 30
